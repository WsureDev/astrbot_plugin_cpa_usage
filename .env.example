# JSON array; provider_id must match AstrBot's current chat provider id.
CPA_PROVIDERS_JSON='[{"provider_id":"openai/main","base_url":"http://127.0.0.1:8317","token":"replace-me","management_prefix":"/v0/management"}]'
# token is the CPA management key. The client reads /v0/management/auth-files,
# auth-files metadata, then calls read-only provider quota endpoints via api-call.
# Optional; otherwise the first provider entry is used by run_manual_test.py.
CPA_TEST_PROVIDER_ID=
CPA_USAGE_TIMEOUT=20
CPA_USAGE_TLS_VERIFY=true
# Standalone HTML -> PNG rendering. The repository has a host-specific
# autodetection fallback, but setting this makes other hosts deterministic.
CPA_CHROMIUM_PATH=
CPA_NODE_PATH=
# Optional custom assets. Relative font/background paths resolve inside here.
CPA_ASSET_DIR=
CPA_FONT_PATH=
CPA_BACKGROUND_IMAGES_JSON=[]
CPA_BACKGROUND_STRATEGY=random
CPA_BACKGROUND_OVERLAY=0.66
CPA_BACKGROUND_POSITION=center top
